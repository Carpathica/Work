        <mxCell id="FZhqZUtZCEvIezFI14KS-10" parent="1" style="rounded=1;whiteSpace=wrap;html=1;spacing=8;spacingTop=6;" value="&lt;div&gt;&lt;span style=&quot;text-align: left; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;•&amp;nbsp;&lt;/span&gt;split_distant_right_auxiliary: поиск разрывов&amp;nbsp;&lt;/div&gt;&lt;div&gt;для отделения кода контейнера от номера&lt;/div&gt;" vertex="1">
