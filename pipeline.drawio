        <mxCell id="FZhqZUtZCEvIezFI14KS-8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;spacing=8;spacingTop=6;" value="&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;• Подавление дубликатов по IoU (внутри одного класса)&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;• Объединение перекрывающихся классов&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;• Удаление обособленных детекций&lt;/div&gt;" vertex="1">
          <mxGeometry height="120" width="470" x="179" y="480" as="geometry" />
        </mxCell>
        <mxCell id="FZhqZUtZCEvIezFI14KS-9" edge="1" parent="1" source="FZhqZUtZCEvIezFI14KS-10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="FZhqZUtZCEvIezFI14KS-2" value="">
          <mxGeometry relative="1" as="geometry" />
