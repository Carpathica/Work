        <mxCell id="FZhqZUtZCEvIezFI14KS-12" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=center;spacingRight=0;spacing=8;spacingTop=10;" value="&lt;div&gt;&amp;nbsp;• +1000: если check_ok (ISO валиден)&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;/div&gt;&lt;div&gt;• +150: формат номера [A-Z]{4}[0-9]{7}&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;• +200..450: наличие size_type в зависимости&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;от раскладки&lt;/span&gt;&lt;/div&gt;&lt;div&gt;• Приоритет раскладок: vertical &amp;gt; horizontal_one&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp; &amp;gt; split_owner_four &amp;gt; и т.д.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="120" width="470" x="179" y="960" as="geometry" />
        </mxCell>
        <mxCell id="FZhqZUtZCEvIezFI14KS-13" parent="1" style="rounded=1;whiteSpace=wrap;html=1;spacing=8;" value="&lt;div&gt;• primary_number: 11-символьный ISO номер&lt;/div&gt;&lt;div&gt;• check_ok: bool валидности контрольной цифры&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;• ordered: список Detection в порядке чтения&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;• size_type_code: 22G1/22GB или None&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;• layout: имя использованной стратегии&amp;nbsp; &amp;nbsp;&lt;/span&gt;&lt;/div&gt;" vertex="1">
