mkdir -p /opt/docker-images

podman pull docker://pytorch/pytorch:2.7.1-cuda11.8-cudnn9-runtime
podman pull docker://python:3.11-slim
podman pull docker://node:20-alpine
podman pull docker://nginx:alpine
podman pull docker://postgres:15
podman pull docker://minio/minio:latest
podman pull docker://vllm/vllm-openai:latest
2) Сохранить в формат, совместимый с Docker

bash

podman save --format docker-archive -o /opt/docker-images/pytorch.tar pytorch/pytorch:2.7.1-cuda11.8-cudnn9-runtime
podman save --format docker-archive -o /opt/docker-images/python311.tar python:3.11-slim
podman save --format docker-archive -o /opt/docker-images/node20.tar node:20-alpine
podman save --format docker-archive -o /opt/docker-images/nginx.tar nginx:alpine
podman save --format docker-archive -o /opt/docker-images/postgres15.tar postgres:15
podman save --format docker-archive -o /opt/docker-images/minio.tar minio/minio:latest
podman save --format docker-archive -o /opt/docker-images/vllm.tar vllm/vllm-openai:latest
3) Загрузить в Docker

bash

docker load -i /opt/docker-images/pytorch.tar
docker load -i /opt/docker-images/python311.tar
docker load -i /opt/docker-images/node20.tar
docker load -i /opt/docker-images/nginx.tar
docker load -i /opt/docker-images/postgres15.tar
docker load -i /opt/docker-images/minio.tar
docker load -i /opt/docker-images/vllm.tar
4) Проверка

bash

docker images | grep -E "pytorch|python|node|nginx|postgres|mini
